{
  "name": "qingci-cet4-xiuxian",
  "version": "1.9.1",
  "description": "青词天路 · 全学段修仙 —— 初中 / 高中 / CET-4 / CET-6 四词库 + 六种记忆题型 + 对战模式 + 学情看板（单文件自包含 HTML，零运行时依赖）",
  "private": true,
  "type": "commonjs",
  "main": "src/core/quiz.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:vocab": "node scripts/build-vocab-detail.mjs",
    "build:lexicon": "node scripts/build-lexicon.mjs",
    "build:mnemonics": "node scripts/build-mnemonics.mjs",
    "build:audio": "node scripts/build-audio-tts.mjs",
    "fetch:voa": "node scripts/fetch-voa-audio.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:deploy": "node scripts/prepare-deploy.mjs",
    "prepare:deploy:workers": "node scripts/prepare-deploy.mjs --workers",
    "deploy": "node scripts/deploy-workers.mjs",
    "deploy:dev": "npm run prepare:deploy:workers && wrangler dev --local",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude='dist/**' --test tests/*.test.js tests/*.test.mjs",
    "start": "node server.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "probe:prod": "node scripts/prod-probe.mjs",
    "probe:prod:strict": "node scripts/prod-probe.mjs --strict",
    "test:docs": "node scripts/verify-docs.js",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:a11y:online": "node scripts/verify-a11y-online.mjs",
    "verify:contrast:online": "node scripts/verify-contrast-online.mjs",
    "verify:examdate:online": "node scripts/verify-exam-date-online.mjs",
    "verify:lazyload:online": "node scripts/verify-lazyload-online.mjs",
    "verify": "npm run typecheck && npm run build && npm run verify:pwa && npm test && npm run test:docs && npm run healthcheck",
    "verify:prod": "npm run typecheck && npm run verify:pwa && npm test && npm run test:docs && node scripts/prod-probe.mjs --strict",
    "verify:minified:runtime": "node scripts/verify-minified-runtime.mjs",
    "verify:cultivation": "node scripts/verify-cultivation-phase1.mjs",
    "verify:cultivation2": "node scripts/verify-cultivation-phase2.mjs"
  },
  "keywords": [
    "CET-4",
    "CET-6",
    "英语四级",
    "英语六级",
    "背单词",
    "PWA",
    "修仙"
  ],
  "license": "MIT",
  "author": "xingyanghaifu",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyanghaifu/qingci-cet4-xiuxian.git"
  },
  "homepage": "https://qingci-cet4-xiuxian.pages.dev",
  "devDependencies": {
    "edge-tts-generator": "^0.1.7",
    "esbuild": "^0.28.2",
    "music-metadata": "^11.16.1",
    "typescript": "^7.0.2"
  }
}
