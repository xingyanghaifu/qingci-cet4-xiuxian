{
  "name": "qingci-cet4-xiuxian",
  "version": "1.0.1",
  "description": "青词天路 · 四级全卷修仙 —— CET-4 词汇修仙学习应用（单文件自包含 HTML + 六种记忆题型 + 对战模式 + 学情看板）",
  "private": true,
  "type": "commonjs",
  "main": "src/core/quiz.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "start": "node server.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "test:docs": "node scripts/verify-docs.js",
    "verify": "npm run build && npm test && npm run test:docs && npm run healthcheck"
  },
  "keywords": [
    "cet4",
    "vocabulary",
    "spaced-repetition",
    "gamification",
    "single-file-app"
  ],
  "license": "MIT",
  "devDependencies": {}
