# 依赖与构建产物
node_modules/
dist/
deploy/
deploy-pages/

# 本地 npm 缓存（受限环境用 --cache .npm-cache 安装依赖，避免写入用户目录）
.npm-cache/

# Wrangler 本地缓存与运行态（含 sqlite 状态库，不应入库）
.wrangler/
.dev.vars

# 运行日志
*.log

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# 历史备份
.history/

# 任务辅助目录（过程文件，不参与版本管理）
任务_*/

# 数据管线缓存（build-vocab-detail.mjs 按词缓存的语料，可重跑生成）
.cache/

# 备份目录（改版前的源码备份与压缩包）
backups/
dist-offline/
